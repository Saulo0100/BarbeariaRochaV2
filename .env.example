# Copie este arquivo para .env e preencha os valores reais.
# Em produção, configure estas variáveis no ambiente (Docker, servidor, etc.)
# O ASP.NET Core lê automaticamente variáveis de ambiente com __ como separador de seção.

# Banco de dados
ConnectionStrings__DefaultConnection=Host=...;Database=Estabelecimentos;Username=...;Password=...;SSL Mode=VerifyFull;Channel Binding=Require;

# JWT
Jwt__Secret=seu-segredo-aqui-minimo-32-caracteres
Jwt__Issuer=GsSytem
Jwt__Audience=Account

# Email (Gmail)
Email__From=seuemail@gmail.com
Email__Host=smtp.gmail.com
Email__Username=seuemail@gmail.com
Email__Password=sua-app-password-gmail

# WhatsApp (Facebook Graph API)
Whatsapp__Verify_Token=seu-verify-token
Whatsapp__Token=seu-bearer-token-facebook
Whatsapp__endpoint=https://graph.facebook.com/v22.0/SEU_PHONE_NUMBER_ID/messages

# CORS (domínios permitidos — separar por índice)
CorsOrigins__0=https://seudominio.com
CorsOrigins__1=https://app.seudominio.com

# APIs externas
Apis__ConfiguracaoBaseUrl=http://endereco-api-config:5001
